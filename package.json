{
  "name": "xterminal-desktop",
  "desktopName": "xTerminal",
  "private": true,
  "version": "1.2.0",
  "description": "xTerminal - Multi-Protocol DevOps & SSH Desktop Workstation",
  "author": {
    "name": "Lyarinet",
    "email": "support@lyarinet.com",
    "url": "https://github.com/lyarinet"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "setup": "node setup.cjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "build:electron": "npm run build && electron-builder --dir",
    "build:electron:win": "npm run build && electron-builder --win nsis",
    "build:electron:portable": "npm run build && electron-builder --win portable",
    "build:electron:mac": "npm run build && electron-builder --mac dmg",
    "build:electron:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:android": "vite build && cap sync android && cap build android",
    "build:tauri": "tauri build"
  },
  "build": {
    "appId": "com.xterminal.desktop",
    "productName": "xTerminal",
    "copyright": "Copyright © 2024 Lyarinet. All rights reserved.",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json",
      "!**/node_modules/ssh2/util/**"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "Lyarinet <support@lyarinet.com>",
      "syncDesktopName": true,
      "synopsis": "Enterprise SSH & Remote Access Workstation",
      "description": "xTerminal Pro — Enterprise Remote Access & Infrastructure Suite. SSH, SFTP, RDP, Serial TTY, Android ADB, TFTP and more.",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "xTerminal",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/novnc__novnc": "^1.6.0",
    "@types/selfsigned": "^2.0.4",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
